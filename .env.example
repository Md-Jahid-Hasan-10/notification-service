# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and must never be committed.

# PostgreSQL
DB_USERNAME=banking_admin
DB_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Base64 32-byte AES key - must be identical to the user-service and otp-service key
# generate with: openssl rand -base64 32
EVENT_CRYPTO_KEY=change-me

# SMTP - the service does not start without these two
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me

# Front-end verification page
VERIFY_URL=http://localhost:3000/verify.html
